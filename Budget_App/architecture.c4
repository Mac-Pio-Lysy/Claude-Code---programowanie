specification {
    element actor {
        style {
            shape person
        }
    }
    element system
    element container
    element component
    element database {
        style {
            shape storage
        }
    }
}

model {
    user = actor 'Uzytkownik' {
        description 'Zarzadza budzetem domowym indywidualnie lub w zespole'
    }

    googleAuth = system 'Google Auth' {
        description 'Logowanie przez konto Google'
    }

    appleAuth = system 'Apple ID' {
        description 'Logowanie przez Apple iCloud'
    }

    ocrCloudService = system 'OCR Cloud / ML Service' {
        description 'Zewnetrzny silnik OCR / Vision API do skanowania paragonow'
    }

    adService = system 'AdMob / Ad Network' {
        description 'Emisja reklam banerowych w wersji Free'
    }

    budgetSystem = system 'System Budzetu Domowego' {
        description 'Wieloplatformowa aplikacja do kontroli budzetu domowego'

        flutterApp = container 'Aplikacja Kliencka (Flutter Multiplatform)' {
            technology 'Flutter / Dart'
            description 'Responsywna aplikacja (macOS, Windows, Web, iOS, Android)'

            authModule = component 'Auth Module (AuthBloc)' {
                description 'Zarzadzanie sesja, logowanie Google/Apple/Email oraz tryb demo'
            }

            workspaceModule = component 'Workspace Module (WorkspacesBloc)' {
                description 'Wybór i zarzadzanie encjami budzetowymi (tagi, online, wspoldzielenie)'
            }

            monetizationModule = component 'Monetization Module (MonetizationCubit)' {
                description 'Bramka limitow Free (1 budzet, banery) vs Premium oraz widok wsparcia'
            }

            sheetModule = component 'Budget Sheet Engine (BudgetSheetBloc)' {
                description 'Stan glowny na poziomie Root, arkusz Excel-like, podsumowania i bilans'
            }

            calcService = component 'Budget Calculator Engine' {
                description 'Arytmetyka wplywow netto, trojstopniowy podzial kosztow i harmonogramy rat'
            }

            savingsModule = component 'Savings Module (SavingsBloc)' {
                description 'Zarzadzanie celami oszczednosciowymi i kalkulator tempa odkladania'
            }

            ocrModule = component 'Receipt Scanner (ReceiptScannerBloc)' {
                description 'Skaner paragonow, parser heurystyczny i bezposredni import do arkusza'
            }

            // Relacje wewnetrzne
            authModule -> workspaceModule 'Autoryzuje dostep do przestrzeni roboczych'
            workspaceModule -> monetizationModule 'Weryfikuje limity budzetow w planie Free'
            workspaceModule -> sheetModule 'Inicjalizuje dane wybranego budzetu (LoadBudgetSheet)'
            sheetModule -> calcService 'Przelicza bilans (wplywy netto - wydatki - raty)'
            ocrModule -> sheetModule 'Importuje zatwierdzone pozycje paragonu jako ExpenseEntry'
            savingsModule -> sheetModule 'Synchronizuje zaalokowane oszczednosci z bilansem'
        }

        backendApi = container 'Backend API & Sync Engine' {
            technology 'Node.js / Supabase / Go'
            description 'Serwer synchronizacji danych w czasie rzeczywistym (Online-Only)'
        }

        centralDb = database 'Glowna Baza Danych' {
            technology 'PostgreSQL'
            description 'Przechowuje uzytkownikow, budzety, wpisy i subskrypcje'
        }

        flutterApp -> backendApi 'Synchronizacja danych i sesji przez REST / WebSocket'
        backendApi -> centralDb 'Zapis i odczyt danych'
    }

    user -> flutterApp 'Wprowadza dane w arkuszu, analizuje wykresy, skanuje paragony'
    flutterApp -> googleAuth 'Uwierzytelnianie SSO'
    flutterApp -> appleAuth 'Uwierzytelnianie SSO'
    flutterApp -> ocrCloudService 'Przesyla zdjecie paragonu (wersja produkcyjna)'
    flutterApp -> adService 'Wyswietla banery (wersja Free)'
}

views {
    view index {
        title 'C1 - Kontekst Systemu Budzetowego'
        include 
            user,
            budgetSystem,
            googleAuth,
            appleAuth,
            ocrCloudService,
            adService
    }

    view containers of budgetSystem {
        title 'C2 - Kontenery Systemu'
        include *
    }

    view flutterAppComponents of budgetSystem.flutterApp {
        title 'C3 - Architektura Komponentow Flutter'
        include *
    }
}
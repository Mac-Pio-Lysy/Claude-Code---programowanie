rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Zalogowani użytkownicy (organizatorzy): pełny dostęp do WSZYSTKICH kolekcji ──
    // Naprawia błąd „Missing or insufficient permissions" przy skanowaniu/odczycie
    // i zapisie kolekcji (np. listowanie weddingPlanner, dashboardLayouts).
    // Reguły w Firestore sumują się (OR) — wyjątki publiczne poniżej tylko ROZSZERZAJĄ dostęp.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Wyjątki PUBLICZNE (goście bez logowania) ──

    // Dane planera: odczyt przed zalogowaniem (initFirebaseSync) oraz odczyt+zapis
    // potwierdzeń RSVP przez gości (rsvp.html, bez logowania).
    // `read` obejmuje get i list — umożliwia też skan/diagnostykę kolekcji.
    match /weddingPlanner/{doc} {
      allow read, write: if true;
    }

    // Propozycje piosenek od gości (muzyka.html, bez logowania): publiczny odczyt i dodawanie.
    // Zmiana statusu i usuwanie objęte regułą ogólną powyżej — tylko zalogowani organizatorzy.
    match /musicProposals/{id} {
      allow read, create: if true;
    }

    // Księga gości (ksiega.html, bez logowania): publiczny odczyt i dodawanie wpisów.
    // Usuwanie objęte regułą ogólną powyżej — tylko zalogowani organizatorzy.
    match /guestbook/{id} {
      allow read, create: if true;
    }

    // Wyniki quizu o Parze Młodej (quiz.html, bez logowania): publiczny odczyt
    // (ranking) i dodawanie wyniku. Pytania czytane z weddingPlanner/main
    // (reguła powyżej). Usuwanie — tylko zalogowani organizatorzy.
    match /quizResults/{id} {
      allow read, create: if true;
    }

    // Rady dla Pary Młodej (rady.html, bez logowania): publiczny odczyt i
    // dodawanie. Usuwanie — tylko zalogowani organizatorzy (reguła ogólna).
    match /advices/{id} {
      allow read, create: if true;
    }

    // Wyniki gry „Prawda czy Fałsz" (prawdafalsz.html, bez logowania): publiczny
    // odczyt (ranking) i dodawanie wyniku. Stwierdzenia czytane z
    // weddingPlanner/main. Usuwanie — tylko zalogowani organizatorzy.
    match /trueFalseResults/{id} {
      allow read, create: if true;
    }

    // Wyniki gry „Zgadnij zdjęcie" (zgadnijzdjecie.html, bez logowania):
    // publiczny odczyt (ranking) i dodawanie wyniku. Pytania/zdjęcia czytane
    // z weddingPlanner/main. Usuwanie — tylko zalogowani organizatorzy.
    match /photoGuessResults/{id} {
      allow read, create: if true;
    }

    // Kapsuła czasu (kapsula.html, bez logowania): publiczny odczyt i dodawanie
    // wiadomości. Usuwanie — tylko zalogowani organizatorzy (reguła ogólna).
    match /timeCapsule/{id} {
      allow read, create: if true;
    }

    // Mapa gości (mapa.html, bez logowania): publiczny odczyt i dodawanie
    // wpisów (miejscowość + współrzędne). Edycja/usuwanie — tylko zalogowani.
    match /guestMap/{id} {
      allow read, create: if true;
    }

    // Foto-wyzwania (fotowyzwania.html, bez logowania): publiczny odczyt i
    // dodawanie zdjęć (wykonane wyzwania). Lista wyzwań w weddingPlanner/main.
    // Usuwanie — tylko zalogowani organizatorzy (reguła ogólna).
    match /photoChallenges/{id} {
      allow read, create: if true;
    }

    // Galeria zdjęć gości: publiczny odczyt i dodawanie; usuwanie tylko organizatorzy.
    match /gallery/{photoId} {
      allow read, create: if true;
      allow delete: if request.auth != null
        && request.auth.token.email in [
          'macholak.piotr@gmail.com',
          'ceremonia.panstwa.macholak@gmail.com',
          'patrycja.staniow@gmail.com'
        ];
    }

    // Zarządzanie dostępem (czarna lista emaili): odczyt dla zalogowanych
    // (sprawdzenie blokady przy logowaniu). UWAGA: zapis jest objęty regułą ogólną
    // powyżej (każdy zalogowany), więc dawna ochrona przed „samo-odblokowaniem"
    // jest złagodzona — zgodnie z wymogiem „dostęp do wszystkich kolekcji dla zalogowanych".
    match /accessControl/main {
      allow read: if request.auth != null;
    }
  }
}

@startuml 02-container
' ============================================================================
' C4 CONTAINER — „Moje Wesele"
'
' Wygenerowane z RZECZYWISTEGO kodu, stan repo:
'   - lib/main.dart — trzy korzenie aplikacji (MojeWeseleApp/InviteEntryApp/
'     GuestWebApp), rozstrzygane parametrami URL na webie
'   - zrodlo-web/*.html + firebase-config.js/auth.js/script.js — ODDZIELNA,
'     starsza aplikacja statyczna dla pojedynczych stron gości
'     (patrz lib/config/public_urls.dart — buduje do niej linki)
'   - lib/services/firestore_service.dart, guest_space_service.dart,
'     auth_service.dart, cloudinary_service.dart
'
' Poziom: główne kontenery (uruchamialne/wdrażalne jednostki) i przepływy
' danych między nimi.
' ============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagram Kontenerów — System „Moje Wesele”

Person(organizer, "Organizator / Współorganizator")
Person(guest, "Gość")

System_Boundary(mojeWesele, "Moje Wesele") {
  Container(mobileApp, "Aplikacja mobilna", "Flutter (Android/iOS)", "Panel organizatora i współorganizatora — logowanie, goście, budżet, plan sali, harmonogram, zaproszenia indywidualne.")

  Container(webApp, "Aplikacja web (Flutter Web)", "Flutter Web, ten sam kod co appka mobilna", "Trzy tryby wg URL (main.dart): panel organizatora (AuthGate), wejście gościa kodem paczki (?i=, InviteEntryApp), wejście gościa wspólnym linkiem (?t=, GuestWebApp).")

  Container(staticGuestPages, "Statyczne strony gości", "HTML/CSS/JS, zrodlo-web/", "Starsza, RÓWNOLEGŁA ścieżka: pojedyncze strony per funkcja (galeria.html, rsvp.html, harmonogram.html, muzyka.html), łączone bezpośrednio z Firebase JS SDK. Adresy budowane przez PublicPages (lib/config/public_urls.dart).")
}

System_Boundary(firebase, "Firebase (projekt wedding-planner-pub)") {
  Container(firebaseAuthC, "Firebase Authentication", "Firebase", "Google OAuth, e-mail/hasło (organizatorzy) oraz logowanie anonimowe (goście, guest_identity.dart) — DWIE oddzielne, nieprzecinające się ścieżki logowania anonimowego (AuthService vs GuestIdentity).")
  ContainerDb(firestoreC, "Cloud Firestore", "NoSQL", "weddings/{id}, memberships/{uid__wid}, guestSpaces/{token}/*, inviteCodes/{KOD}, users/{uid}, weddingCodes/{KOD}, roleInvites/{KOD}, usersByEmail/{email}. Dostęp egzekwowany przez firestore.rules.")
}

System_Ext(cloudinaryC, "Cloudinary", "Hosting zdjęć (galeria, foto-wyzwania).")
System_Ext(deezerC, "Deezer API", "Wyszukiwanie utworów.")
System_Ext(nominatimC, "Nominatim (OSM)", "Geokodowanie adresów.")

Rel(organizer, mobileApp, "używa", "appka")
Rel(organizer, webApp, "używa (panel)", "przeglądarka")
Rel(guest, webApp, "wchodzi ?i=KOD lub ?t=TOKEN", "przeglądarka")
Rel(guest, staticGuestPages, "otwiera pojedynczą stronę (link z panelu)", "przeglądarka")

Rel(mobileApp, firebaseAuthC, "loguje (Google / e-mail+hasło)", "Firebase Auth SDK")
Rel(mobileApp, firestoreC, "czyta/zapisuje dane wesela wg roli (fullAccess)", "Cloud Firestore SDK")

Rel(webApp, firebaseAuthC, "loguje organizatora LUB anonimowo gościa", "Firebase Auth SDK")
Rel(webApp, firestoreC, "organizator: pełny dostęp wg roli · gość: guestSpaces/{token} + weddings/{id}/guestView", "Cloud Firestore SDK")
Rel(webApp, cloudinaryC, "przesyła zdjęcia", "HTTPS upload API")
Rel(webApp, deezerC, "wyszukuje utwory", "REST")
Rel(webApp, nominatimC, "geokoduje adresy", "REST")

Rel(staticGuestPages, firebaseAuthC, "logowanie anonimowe gościa", "Firebase JS SDK")
Rel(staticGuestPages, firestoreC, "czyta/zapisuje wpisy gościa (starsza ścieżka, per-strona)", "Firebase JS SDK")

@enduml

@startuml 03-component-auth
' ============================================================================
' C4 COMPONENT — Warstwa uwierzytelniania (organizator)
'
' Wygenerowane z RZECZYWISTEGO kodu:
'   - lib/widgets/auth_gate.dart (AuthGate — bramka logowania)
'   - lib/services/auth_service.dart (Google + e-mail/hasło)
'   - lib/screens/login_screen.dart, email_auth_screen.dart
'   - lib/screens/lock/lock_screen.dart + services/app_lock_service.dart
'   - lib/screens/weddings/weddings_list_screen.dart
'   - lib/services/membership_service.dart
'   - lib/services/guest_identity.dart — CELOWO osobna ścieżka od AuthService
'
' Poziom: komponenty wewnątrz kontenera "Aplikacja mobilna / web" (część
' logowania organizatora), plus dla kontrastu — osobna ścieżka gościa.
' ============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagram Komponentów — Uwierzytelnianie organizatora

System_Ext(firebaseAuth, "Firebase Authentication")
ContainerDb_Ext(firestore, "Cloud Firestore")

Container_Boundary(authLayer, "Warstwa auth — organizator") {
  Component(authGate, "AuthGate", "StatefulWidget\nwidgets/auth_gate.dart", "Nasłuchuje authStateChanges(). Wg stanu pokazuje: LoginScreen, EmailAuthScreen, LockScreen, WeddingsListScreen, MainNavigation albo GuestHomeScreen (rola 'guest' w weselu).")
  Component(authService, "AuthService", "Dart class\nservices/auth_service.dart", "signInWithGoogle(), registerWithEmail(), signInWithEmail(), sendPasswordResetEmail(), signOut(), authStateChanges(), currentUser.")
  Component(loginScreen, "LoginScreen", "StatelessWidget\nscreens/login_screen.dart", "Przycisk 'Zaloguj przez Google' + przycisk do EmailAuthScreen. Google i e-mail NIE są łączone (osobne konta).")
  Component(emailAuthScreen, "EmailAuthScreen", "StatefulWidget\nscreens/email_auth_screen.dart", "Jeden ekran, trzy tryby: logowanie / rejestracja / reset hasła e-mailem.")
  Component(lockScreen, "LockScreen + AppLockService", "StatefulWidget + service\nscreens/lock/, services/app_lock_service.dart", "PIN/biometria PO auto-loginie (nie po świadomym logowaniu — _interactiveSignIn).")
  Component(weddingsListScreen, "WeddingsListScreen", "StatefulWidget\nscreens/weddings/weddings_list_screen.dart", "Lista wesel użytkownika (z memberships) → wybór aktywnego ActiveWedding.id.")
  Component(membershipService, "MembershipService", "Dart class\nservices/membership_service.dart", "CRUD memberships/{uid}__{weddingId}: rola, status, expiresAtTimestamp.")
}

Container_Boundary(guestAuth, "Uwierzytelnianie gościa — OSOBNA ścieżka") {
  Component(guestIdentity, "GuestIdentity", "Dart class\nservices/guest_identity.dart", "ensure() → własne signInAnonymously() na FirebaseAuth.instance. NIE korzysta z AuthService — świadomie oddzielone (bezwarunkowe logowanie anonimowe wylogowałoby organizatora z Google).")
}

Rel(authGate, authService, "wywołuje", "Dart")
Rel(loginScreen, authGate, "onGoogleSignIn / onEmailAuth", "callback")
Rel(emailAuthScreen, authGate, "onSignIn / onRegister / onResetPassword\n(zwraca komunikat błędu albo null)", "callback")
Rel(authGate, loginScreen, "pokazuje, gdy brak sesji")
Rel(authGate, lockScreen, "pokazuje przy auto-loginie z włączoną blokadą")
Rel(authGate, weddingsListScreen, "pokazuje po zalogowaniu / odblokowaniu")
Rel(weddingsListScreen, membershipService, "czyta członkostwa użytkownika")
Rel(membershipService, firestore, "memberships/{uid}__{weddingId}", "Firestore SDK")

Rel(authService, firebaseAuth, "signInWithGoogle / createUserWithEmailAndPassword /\nsignInWithEmailAndPassword / sendPasswordResetEmail", "Firebase Auth SDK")
Rel(guestIdentity, firebaseAuth, "signInAnonymously()", "Firebase Auth SDK")

note bottom of guestAuth
  Historyczna uwaga: dawny "tryb testowy" (bypassLogin) miał WŁASNĄ metodę
  AuthService.signInAnonymously() — usuniętą jako martwy kod. Prawdziwa
  strefa gości od zawsze używa wyłącznie GuestIdentity, nie AuthService.
end note

@enduml

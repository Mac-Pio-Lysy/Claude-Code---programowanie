@startuml 05-component-data-layer
' ============================================================================
' C4 COMPONENT — Warstwa danych (serwisy)
'
' Wygenerowane z RZECZYWISTEGO kodu:
'   - lib/services/firestore_service.dart (bazowy dostęp do weddings/{id})
'   - lib/services/active_wedding.dart (globalny ActiveWedding.id)
'   - lib/services/wedding_service.dart, membership_service.dart,
'     guest_service.dart, invite_code_service.dart, guest_space_service.dart
'   - lib/services/*.dart — ok. 45 plików serwisów w lib/services/, wspólny
'     wzorzec: odczyt _firestore.readData(), zapis
'     _firestore.mainDoc.set({...}, SetOptions(merge: true))
'
' Poziom: JAK aplikacja rozmawia z Firestore — dwa różne wzorce dostępu:
' organizator (przez FirestoreService, kontekst ActiveWedding.id) kontra
' gość/publiczne kolekcje (bezpośrednio FirebaseFirestore.instance, wg
' tokenu/kodu, BEZ ActiveWedding).
' ============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagram Komponentów — Warstwa danych (serwisy)

ContainerDb_Ext(firestore, "Cloud Firestore")

Container_Boundary(orgAccess, "Dostęp ORGANIZATORA — kontekst aktywnego wesela") {
  Component(activeWedding, "ActiveWedding", "Dart static holder\nservices/active_wedding.dart", "Globalne ActiveWedding.id — ustawiane po wyborze wesela na WeddingsListScreen.")
  Component(firestoreService, "FirestoreService", "Dart class\nservices/firestore_service.dart", "mainDoc = weddings/{ActiveWedding.id}. readData(), weddingId. Bazowy punkt dostępu dla większości serwisów domenowych.")

  Component(weddingService, "WeddingService", "Dart class\nservices/wedding_service.dart", "Zakładanie/dołączanie do wesela, ensureGuestViewForUser, _guestMirror() → mirror do guestSpaces/{token} i weddings/{id}/guestView/main.")
  Component(membershipService, "MembershipService", "Dart class\nservices/membership_service.dart", "memberships/{uid}__{weddingId} — rola, status, wygaśnięcie planera.")
  Component(guestServiceD, "GuestService", "Dart class\nservices/guest_service.dart", "addGuest / updateGuest / deleteGuest / createCompanionFor / createCompanionWithId — lista weddings/{id}.guests.")
  Component(inviteCodeServiceD, "InviteCodeService", "Dart class\nservices/invite_code_service.dart", "Prywatny indeks weddings/{id}.invitePackages (przez FirestoreService) + publiczny inviteCodes/{KOD} (bezpośrednio).")
  Component(domainServices, "Serwisy domenowe (~30 klas)", "Dart classes\nservices/*.dart", "budget_service, table_service, task_service, vendor_service, schedule_service, room_service, gift_service, transport_service, accommodation_service, planning_service, guest_visibility_service, config_service, ...\nJeden wzorzec: FirestoreService.mainDoc.set(merge:true).")
}

Container_Boundary(guestAccess, "Dostęp GOŚCIA / publiczny — bez ActiveWedding") {
  Component(guestSpaceServiceD, "GuestSpaceService", "Dart class\nservices/guest_space_service.dart", "Własna FirebaseFirestore.instance, kluczowana TOKENEM (guestSpaces/{token}), NIGDY weddingId. addGuestbookEntry, saveRsvp, watchGallery, watchUnassignedIdentities, updateEntry/deleteEntry (moderacja).")
  Component(inviteIdentityServiceD, "InviteIdentityService", "Dart class\nservices/invite_identity_service.dart", "Własna FirebaseFirestore.instance — load(code), claim(doc, identity). Działa PRZED ustaleniem tożsamości, więc nie ma kontekstu wesela.")
  Component(guestIdentityD, "GuestIdentity", "Dart class\nservices/guest_identity.dart", "uid anonimowej sesji gościa — używany jako klucz dokumentów 'jeden wpis na gościa' (rsvp/{uid}, guestMap/{uid}).")
}

Rel(activeWedding, firestoreService, "wyznacza weddingId")
Rel(weddingService, firestoreService, "korzysta z")
Rel(membershipService, firestore, "memberships/{uid}__{weddingId}", "bezpośrednio (bez FirestoreService — działa PRZED wyborem wesela)")
Rel(guestServiceD, firestoreService, "korzysta z")
Rel(inviteCodeServiceD, firestoreService, "prywatny indeks: weddings/{id}.invitePackages")
Rel(inviteCodeServiceD, firestore, "publiczny indeks: inviteCodes/{KOD}", "bezpośrednio")
Rel(domainServices, firestoreService, "korzysta z")
Rel(firestoreService, firestore, "weddings/{ActiveWedding.id}", "Cloud Firestore SDK")

Rel(guestSpaceServiceD, firestore, "guestSpaces/{token}/*", "Cloud Firestore SDK, bezpośrednio")
Rel(inviteIdentityServiceD, firestore, "inviteCodes/{code} (odczyt), guestSpaces/{token}/identities (zapis)", "Cloud Firestore SDK, bezpośrednio")
Rel(guestIdentityD, firestore, "sygnuje wpisy własnym uid", "pośrednio, przez GuestSpaceService")

Rel(weddingService, guestSpaceServiceD, "publikuje mirror (_guestMirror) do tego samego dokumentu guestSpaces/{token}, który czyta GuestSpaceService", "ten sam dokument, różni pisarze/czytelnicy")

note bottom of guestAccess
  Świadomy podział architektoniczny: serwisy w tej grupie NIGDY nie znają
  weddingId ani ActiveWedding — token/kod jest jedynym kluczem, dokładnie
  tak, jak wymaga tego firestore.rules (guestToken rozwiązuje weddingId
  DOPIERO wewnątrz reguł, przez funkcję tokenWedding()).
end note

@enduml

rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// REGUŁY TESTOWE - CAŁKOWICIE OTWARTE - zastąpić bezpiecznymi przed wydaniem
//
// Na czas budowy architektury WIELU wesel: pełny odczyt i zapis dla WSZYSTKICH.
// Powód: w trybie `bypassLogin` aplikacja może działać BEZ zalogowania
// (logowanie anonimowe bywa wyłączone w projekcie), więc `request.auth` jest
// null i reguły oparte na uwierzytelnieniu blokowałyby zapis do nowych
// kolekcji (weddings, memberships, users).
//
// PRAWDZIWA IZOLACJA (do zrobienia w OSOBNYM kroku):
//   • users/{uid}          — tylko właściciel dokumentu,
//   • weddings/{id}        — tylko użytkownicy z powiazaniem do tego wesela,
//   • memberships/{id}     — tylko właściciel powiązania / owner wesela,
//   • gallery/guestbook/musicProposals — publiczny odczyt + dodawanie (goście),
//     usuwanie tylko organizatorzy.
//
// NIE WYDAWAĆ Z TYMI REGUŁAMI. Zastąpić bezpiecznymi regułami przed premierą.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // REGUŁY TESTOWE - CAŁKOWICIE OTWARTE - zastąpić bezpiecznymi przed wydaniem
    // Pełny dostęp do wszystkich kolekcji (weddings, memberships, users,
    // gallery, guestbook, musicProposals, weddingPlanner, …) — bez wyjątków,
    // BEZ wymogu logowania (działa z bypassLogin, gdy request.auth == null).
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

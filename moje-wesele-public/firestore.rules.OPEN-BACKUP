rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// PLAN AWARYJNY — REGUŁY CAŁKOWICIE OTWARTE (tylko na wypadek zablokowania)
//
// Jeśli po wdrożeniu reguł izolacji aplikacja przestanie działać, przywróć
// dostęp jedną komendą:
//
//   cp firestore.rules.OPEN-BACKUP firestore.rules
//   firebase deploy --only firestore:rules --project wedding-planner-pub
//
// (albo wklej treść poniżej w Firebase Console → Firestore → Rules → Publish)
//
// NIE ZOSTAWIAĆ TYCH REGUŁ NA STAŁE — to awaryjny powrót do stanu testowego.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

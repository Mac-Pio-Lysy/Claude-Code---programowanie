  "gh_title": "Wesele",
  "gh_loadError": "Nie udało się wczytać strefy gości.",
  "gh_loadErrorHint": "Sprawdź połączenie z internetem i spróbuj ponownie.",
  "gh_notReady": "Strefa gości nie jest jeszcze gotowa",
  "gh_notReadyBody": "Para Młoda jeszcze jej nie przygotowała. Zajrzyj później albo poproś ją o udostępnienie sekcji dla gości.",
  "gh_account": "Konto",
  "gh_guide": "Przewodnik",
  "gh_switchWedding": "Zmień wesele",
  "sec_backupPin": "PIN",
  "sec_backupPattern": "wzór",
  "@sec_backupPattern": {
    "description": "Zapasowa metoda odblokowania; użyta w zdaniu „Aktualnie: wzór.\"."
  },
  "bio_reason": "Potwierdź tożsamość, aby odblokować aplikację",
  "@bio_reason": {
    "description": "Komunikat systemowego okna biometrii (Android/iOS)."
  },
  "bio_signInTitle": "Logowanie biometryczne",
  "bio_hint": "Zweryfikuj tożsamość",
  "bio_notRecognized": "Nie rozpoznano — spróbuj ponownie",
  "bio_success": "Rozpoznano",
  "bio_settings": "Ustawienia",
  "bio_settingsHint": "Skonfiguruj biometrię w ustawieniach urządzenia.",
  "help_start_title": "Start",
  "@help_start_title": {
    "description": "Nazwa kategorii na ekranie Pomocy (rozwijana sekcja)."
  },
  "help_start_1Title": "Pulpit",
  "help_start_1Body": "Licznik dni do ślubu, skróty do sekcji i najważniejsze statystyki. Układ kafelków ustawiasz sam — możesz ukryć te, których nie używasz.",
  "@help_start_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_start_2Title": "Od czego zacząć?",
  "help_start_2Body": "Sugerowana kolejność planowania wesela. Odhaczaj ukończone kroki, a pasek pokaże postęp. Otworzysz ją z Ustawień w dowolnym momencie — lista jest wspólna dla wszystkich organizatorów wesela.",
  "@help_start_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_start_3Title": "Przewodnik a Pomoc",
  "help_start_3Body": "Przewodnik prowadzi po aplikacji krok po kroku i podświetla elementy na ekranie. Pomoc (ten ekran) to encyklopedia funkcji do czytania wtedy, gdy szukasz konkretnej odpowiedzi.",
  "@help_start_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guests_title": "Goście",
  "help_guests_1Title": "Lista gości",
  "help_guests_1Body": "Dodawaj zaproszonych i zarządzaj ich danymi. Każdy gość może mieć osobę towarzyszącą — dodaj ją przy wpisie, a nie jako osobnego gościa, dzięki czemu liczby w podsumowaniu się zgadzają.",
  "@help_guests_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guests_2Title": "Kartoteka",
  "help_guests_2Body": "Szczegóły przydatne przy organizacji: dieta, alergie, wiek, potrzeba noclegu i transportu, uwagi. Te dane napędzają też kalkulacje w Budżecie i przypisania w Noclegach.",
  "@help_guests_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guests_3Title": "Podsumowanie gości",
  "help_guests_3Body": "Zbiorcze liczby: zaproszeni, potwierdzeni, dzieci, diety. Sprawdź je przed rozmową z salą — to na ich podstawie ustala się catering.",
  "@help_guests_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guests_4Title": "Potwierdzenia obecności (RSVP)",
  "help_guests_4Body": "Masz dwa źródła: wpisy, które sam dodasz w panelu, oraz potwierdzenia przysłane przez gości ze strefy gości. Te drugie znajdziesz w Ustawieniach → Interakcje gości → RSVP. Każdy gość może wysłać jedno potwierdzenie i sam je poprawić, jeśli plany się zmienią.",
  "@help_guests_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_title": "Budżet",
  "help_budget_1Title": "Jedno źródło danych — najważniejsza zasada",
  "help_budget_1Body": "Pozycja dodana w Dostawcach, Prezentach czy Podróży poślubnej pojawia się w Budżecie automatycznie, z etykietą „dodano w…\". Edytuj ją tam, gdzie powstała — dzięki temu nic nie liczy się podwójnie i nie musisz pilnować dwóch list.",
  "@help_budget_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_2Title": "Podsumowanie budżetu",
  "help_budget_2Body": "Limit kontra wydatki, ile zostało do rozdysponowania oraz zestawienie wszystkich płatności i terminów w jednym miejscu.",
  "@help_budget_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_3Title": "Sala i catering",
  "help_budget_3Body": "Stawkę podajesz za osobę, a aplikacja przelicza koszt z liczby gości. Możesz osobno wliczyć obsługę (fotograf, zespół), dzieci po innej stawce i gości jeszcze nieprzypisanych do stołów. Ustaw też minimum gwarantowane przez salę, jeśli umowa je przewiduje.",
  "@help_budget_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_4Title": "Wydatki",
  "help_budget_4Body": "Pozostałe koszty pogrupowane w kategorie. Kategorie edytujesz w Ustawieniach → Konfiguracja.",
  "@help_budget_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_5Title": "Alkohol i napoje",
  "help_budget_5Body": "Rodzaje, ilości i ceny — osobno alkohol, osobno napoje bezalkoholowe. Przydaje się przy ustalaniu, co bierzecie własne, a co z sali.",
  "@help_budget_5Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_6Title": "Podróż poślubna",
  "help_budget_6Body": "Liczona osobno od kosztów wesela, żeby nie zaburzała budżetu przyjęcia — ale jej płatności widać w Podsumowaniu razem z pozostałymi.",
  "@help_budget_6Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_budget_7Title": "Raty i terminy płatności",
  "help_budget_7Body": "Przy dostawcy lub wydatku rozpisz raty z datami. Nadchodzące terminy zobaczysz w Podsumowaniu budżetu i na pulpicie.",
  "@help_budget_7Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_room_title": "Plan sali",
  "help_room_1Title": "Układanie sali",
  "help_room_1Body": "Włącz „Edytuj plan\", aby przeciągać stoły i elementy oraz zmieniać ich rozmiar. Poza trybem edycji plan służy do przeglądania i przypisywania gości — trudniej wtedy coś przypadkiem przesunąć.",
  "@help_room_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_room_2Title": "Przypisywanie gości do stołów",
  "help_room_2Body": "Przeciągnij gościa na miejsce przy stole. Goście nieprzypisani są widoczni osobno — pamiętaj o nich, bo mogą wliczać się do kosztu cateringu, zależnie od ustawień w Budżecie.",
  "@help_room_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_room_3Title": "Stoły obsługi",
  "help_room_3Body": "Stoliki dla fotografa, zespołu czy obsługi oznacz osobno — mają własną stawkę cateringową i nie mieszają się z listą gości.",
  "@help_room_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_schedule_title": "Harmonogram i zadania",
  "help_schedule_1Title": "Plan dnia",
  "help_schedule_1Body": "Punkty programu z godzinami, kategorią i miejscem. To najważniejszy dokument dnia ślubu — przyda się fotografowi, zespołowi i obsłudze sali.",
  "@help_schedule_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_schedule_2Title": "Punkt prywatny",
  "help_schedule_2Body": "Punkt oznaczony jako prywatny NIE trafia do strefy gości. Używaj go do spraw organizacyjnych: „przyjazd florystki\", „rozliczenie z salą\".",
  "@help_schedule_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_schedule_3Title": "Link do miejsca dla gości",
  "help_schedule_3Body": "Przy punkcie możesz podać link do mapy i osobno zdecydować, czy pokazać go gościom. Bez zaznaczenia tej opcji link zostaje tylko dla Was.",
  "@help_schedule_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_schedule_4Title": "Checklista",
  "help_schedule_4Body": "Lista rzeczy do odhaczenia przed weselem i w jego trakcie — osobna od Zadań, bo służy do szybkiego „zrobione / niezrobione\".",
  "@help_schedule_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_schedule_5Title": "Zadania i powiązania",
  "help_schedule_5Body": "Zadaniu możesz przypisać osobę odpowiedzialną i powiązać je z wydatkiem, dostawcą lub prezentem. Dzięki temu z jednego miejsca widzisz, co zostało do zrobienia i ile to kosztuje.",
  "@help_schedule_5Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_vendors_title": "Dostawcy, transport, noclegi",
  "help_vendors_1Title": "Dostawcy",
  "help_vendors_1Body": "Kontakty, kwoty umów, statusy płatności i raty. Kwota dostawcy trafia do Budżetu automatycznie — nie dodawaj jej drugi raz jako wydatku.",
  "@help_vendors_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_vendors_2Title": "Transport",
  "help_vendors_2Body": "Trasy, pojazdy i przypisanie pasażerów. Informacja „potrzebuje transportu\" pochodzi z kartoteki gościa.",
  "@help_vendors_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_vendors_3Title": "Noclegi",
  "help_vendors_3Body": "Obiekty, pokoje i rezerwacje dla gości. Podobnie jak transport — korzysta z oznaczeń w kartotece.",
  "@help_vendors_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guestZone_title": "Strefa gości",
  "help_guestZone_1Title": "Link i kod QR dla gości",
  "help_guestZone_1Body": "Ustawienia → „Link i QR dla gości\". Gość otwiera stronę bez logowania i bez instalowania aplikacji. Ten kod drukujesz na zaproszeniach albo kładziesz na stołach.",
  "@help_guestZone_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guestZone_2Title": "Kod dołączenia (konto gościa)",
  "help_guestZone_2Body": "Sześcioznakowy kod dla gościa, który chce mieć wesele na własnym koncie. Weryfikacja jest potrójna: kod, data ślubu i nazwisko — sam kod nie wystarczy, bo bywa jawny na stołach.",
  "@help_guestZone_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guestZone_3Title": "Widoczność sekcji dla gości",
  "help_guestZone_3Body": "Decydujesz, które sekcje widzą goście i w jakim okresie (daty OD/DO). Wybierasz też, co się dzieje poza zakresem: komunikat „dostępne od…\" albo całkowite ukrycie kafelka. Typowo: RSVP włącz od razu, galerię dopiero w dniu wesela.",
  "@help_guestZone_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guestZone_4Title": "Interakcje gości i moderacja",
  "help_guestZone_4Body": "Ustawienia → „Interakcje gości\". W jednym miejscu zbierają się potwierdzenia, wpisy księgi, rady, zdjęcia, propozycje muzyki i wyniki gier. Każdy wpis możesz usunąć jednym kliknięciem.",
  "@help_guestZone_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_guestZone_5Title": "Czego gość nie widzi",
  "help_guestZone_5Body": "Budżet, pełna lista gości, dostawcy, plan sali i zadania są dla gościa niedostępne — i nie chodzi o ukrycie w interfejsie, tylko o techniczny brak dostępu do tych danych.",
  "@help_guestZone_5Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_media_title": "Zdjęcia i muzyka",
  "help_media_1Title": "Galeria",
  "help_media_1Body": "Wspólny album: goście wrzucają zdjęcia ze swoich telefonów, Wy widzicie wszystko w panelu i możecie usuwać niechciane wpisy.",
  "@help_media_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_media_2Title": "Muzyka i propozycje gości",
  "help_media_2Body": "Budujesz playlistę wesela, a goście przysyłają propozycje utworów. Propozycje widzicie tylko Wy — nie ma publicznej listy ani głosowania. Każdą oznaczysz jako „Zagramy\" lub „Odrzucona\".",
  "@help_media_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_games_title": "Gry i pamiątki",
  "help_games_1Title": "Quiz, Prawda/Fałsz, Zgadnij zdjęcie",
  "help_games_1Body": "Dodaj pytania i włącz grę przełącznikiem „aktywna\". Gość gra na swoim telefonie, a wynik trafia do Was. Publicznego rankingu nie ma — nikt nie porównuje się z innymi.",
  "@help_games_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_games_2Title": "Foto-wyzwania",
  "help_games_2Body": "Lista zadań fotograficznych z punktami. Gość wysyła po jednym zdjęciu do każdego wyzwania; kolejne zastępuje poprzednie.",
  "@help_games_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_games_3Title": "Ślubne Bingo",
  "help_games_3Body": "Pola bingo możesz wpisać ręcznie lub wygenerować z punktów harmonogramu. Plansze drukujesz do PDF, a goście mogą też grać na telefonie.",
  "@help_games_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_games_4Title": "Pamiątki",
  "help_games_4Body": "Księga gości, rady dla Pary Młodej, kapsuła czasu i mapa gości. Kapsuła jest prywatna — czytacie ją tylko Wy.",
  "@help_games_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_title": "Role i dostęp",
  "help_roles_1Title": "Właściciel ma władzę nadrzędną",
  "help_roles_1Body": "Konto Pary Młodej jest najważniejsze. Tylko właściciel dodaje osoby, wystawia zaproszenia i może każdemu odebrać dostęp — także planerowi.",
  "@help_roles_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_2Title": "Współorganizator",
  "help_roles_2Body": "Świadek, mama, przyjaciółka — pełny panel bez daty ważności. Nie może jednak dodawać kolejnych osób; to zostaje przy właścicielu.",
  "@help_roles_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_3Title": "Planer i data ważności",
  "help_roles_3Body": "Planerowi możesz nadać dostęp z datą wygaśnięcia. Po tej dacie wesele znika z jego listy. Dostęp da się w każdej chwili zablokować i przywrócić — wielokrotnie.",
  "@help_roles_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_4Title": "Jak dodać planera lub współorganizatora — krok po kroku",
  "help_roles_4Body": "Ustawienia → „Osoby i dostęp\" → „Dodaj osobę\". Wybierz rolę (Współorganizator albo Planer), a przy planerze ustaw datę ważności dostępu. Potem masz dwie drogi: podać adres e-mail osoby (musi już mieć konto w aplikacji) albo wygenerować kod zaproszenia i przekazać go dowolnym kanałem. Zaproszenie dodaje osobę tylko do TEGO wesela — przy kilku weselach każde wymaga osobnego zaproszenia.",
  "@help_roles_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_5Title": "Jak działa kod zaproszenia",
  "help_roles_5Body": "Kod jest jednorazowy i przypisany do konkretnego wesela oraz roli. Osoba, która go dostanie, zakłada konto (albo loguje się na istniejące), a następnie na liście wesel wybiera „Mam kod zaproszenia (współorganizator / planer)\" i wpisuje go. Po wykorzystaniu kod przestaje działać — dla kolejnej osoby wygeneruj nowy. To inna ścieżka niż kod dla gości, którym goście dołączają do strefy gościa.",
  "@help_roles_5Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_6Title": "Data ważności dostępu planera",
  "help_roles_6Body": "Datę ustawiasz przy zapraszaniu i zmieniasz później na liście osób. Po jej upływie wesele znika z listy planera i traci on dostęp do danych — bez usuwania czegokolwiek u Ciebie. Datę można przesunąć, a dostęp zablokować i przywrócić wielokrotnie. Współorganizator daty ważności nie ma.",
  "@help_roles_6Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_roles_7Title": "Odbieranie dostępu",
  "help_roles_7Body": "Na liście „Osoby i dostęp\" przy każdej osobie znajdziesz blokadę i usunięcie. Blokada zostawia osobę na liście (można ją odblokować), usunięcie kasuje członkostwo — powrót wymaga nowego zaproszenia. Właściciela nie da się usunąć.",
  "@help_roles_7Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_analytics_title": "Analityka",
  "help_analytics_1Title": "Wykresy i statystyki",
  "help_analytics_1Body": "Postępy organizacji, struktura kosztów i frekwencja. Dobre miejsce, by sprawdzić, czy budżet nie rozjeżdża się z planem.",
  "@help_analytics_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_settings_title": "Ustawienia i dane",
  "help_settings_1Title": "Konfiguracja wesela",
  "help_settings_1Body": "Nazwa, data, godzina, miejsca ceremonii i przyjęcia, podział kosztów oraz słowniki (menu, kategorie wydatków). Po zmianie daty lub nazwisk zapisz konfigurację — odświeża to dane dołączania gości.",
  "@help_settings_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_settings_2Title": "Synchronizacja",
  "help_settings_2Body": "Dane zapisują się w chmurze i są wspólne dla wszystkich organizatorów wesela. Kartę statusu znajdziesz na górze Ustawień.",
  "@help_settings_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_settings_3Title": "Kopie zapasowe i eksport",
  "help_settings_3Body": "Możesz utworzyć kopię zapasową oraz wyeksportować wszystkie dane do pliku JSON. Import nadpisuje dane wesela — używaj ostrożnie.",
  "@help_settings_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_settings_4Title": "Blokada aplikacji",
  "help_settings_4Body": "PIN, wzór lub biometria zabezpieczają dostęp na tym urządzeniu. Ustawienie jest lokalne — nie przenosi się na inne telefony.",
  "@help_settings_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_title": "Praca z klientami",
  "help_planner_1Title": "Wiele wesel na jednym koncie",
  "help_planner_1Body": "Możesz prowadzić dowolnie wiele wesel. Przełączasz je w menu pod logo → „Zmień wesele\". Dane każdego wesela są w pełni oddzielone — klient A nigdy nie zobaczy wesela klienta B.",
  "@help_planner_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_2Title": "Twój dostęp bywa czasowy",
  "help_planner_2Body": "Para Młoda może nadać Ci dostęp z datą ważności oraz zablokować go i przywrócić. Gdy wesele zniknie z Twojej listy, to najczęściej wygasła data, a nie awaria — poproś klienta o przedłużenie.",
  "@help_planner_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_3Title": "Czego planer nie może",
  "help_planner_3Body": "Dodawanie osób i wystawianie zaproszeń jest zarezerwowane dla właściciela wesela. To celowe: klient ma zawsze kontrolę nad tym, kto ma dostęp do jego danych.",
  "@help_planner_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_4Title": "Przekazanie wesela Parze",
  "help_planner_4Body": "Nie ma osobnego „przekazania\" — wesele od początku należy do Pary Młodej. Gdy kończycie współpracę, po prostu tracisz dostęp, a wszystkie dane zostają u klienta. Nic nie trzeba eksportować.",
  "@help_planner_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_5Title": "Dane osobowe klientów",
  "help_planner_5Body": "Lista gości zawiera dane osobowe: nazwiska, telefony, adresy e-mail, informacje o dietach. Traktuj je poufnie i nie przenoś między weselami.",
  "@help_planner_5Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_planner_6Title": "Co pokazać klientowi",
  "help_planner_6Body": "Najczęściej sprawdzają się: Podsumowanie budżetu (na co idą pieniądze), plan sali (wydruk) i harmonogram dnia. Analityka daje gotowy materiał na podsumowanie postępów.",
  "@help_planner_6Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gStart_title": "Na start",
  "help_gStart_1Title": "Czym jest ta strona",
  "help_gStart_1Body": "To strefa gości przygotowana przez Parę Młodą. Nie musisz zakładać konta ani niczego instalować — wystarczy link lub kod QR z zaproszenia.",
  "@help_gStart_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gStart_2Title": "Nie widzę jakiejś sekcji",
  "help_gStart_2Body": "Para Młoda sama decyduje, co i kiedy udostępnia. Część sekcji pojawia się dopiero bliżej wesela, a niektóre znikają po nim. Zajrzyj później.",
  "@help_gStart_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gRsvp_title": "Potwierdzenie obecności",
  "help_gRsvp_1Title": "Jak potwierdzić obecność",
  "help_gRsvp_1Body": "Wejdź w RSVP, wpisz imię i nazwisko, zaznacz, czy będziesz, i wyślij. Jeśli przyjeżdżasz z kimś, podaj liczbę osób towarzyszących — nie wypełniaj formularza drugi raz za tę osobę.",
  "@help_gRsvp_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gRsvp_2Title": "Zmiana odpowiedzi",
  "help_gRsvp_2Body": "Wystarczy jedno potwierdzenie. Gdy plany się zmienią, wróć do RSVP — formularz wypełni się Twoją poprzednią odpowiedzią, a po zapisaniu zastąpi ją nowa.",
  "@help_gRsvp_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gRsvp_3Title": "Dieta i alergie",
  "help_gRsvp_3Body": "Wpisz je w formularzu potwierdzenia. Ta informacja trafia prosto do Pary Młodej i pomaga ustalić menu z salą.",
  "@help_gRsvp_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gPhotos_title": "Zdjęcia",
  "help_gPhotos_1Title": "Dodawanie zdjęć",
  "help_gPhotos_1Body": "W Galerii podaj imię, wybierz zdjęcie z telefonu lub zrób je od razu aparatem. Możesz dorzucić podpis. Zdjęć możesz dodać dowolnie wiele.",
  "@help_gPhotos_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gPhotos_2Title": "Kto widzi moje zdjęcia",
  "help_gPhotos_2Body": "Galeria jest wspólna — widzą ją wszyscy goście z linkiem oraz Para Młoda. Para może usunąć każde zdjęcie.",
  "@help_gPhotos_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gMusic_title": "Muzyka",
  "help_gMusic_1Title": "Propozycja utworu",
  "help_gMusic_1Body": "Wyszukaj piosenkę albo wpisz tytuł i wykonawcę ręcznie, a potem wyślij propozycję. Jeśli wyszukiwarka nie działa (bywa tak w przeglądarce), skorzystaj z pól ręcznych — efekt jest taki sam.",
  "@help_gMusic_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gMusic_2Title": "Kto widzi propozycje",
  "help_gMusic_2Body": "Tylko Para Młoda. Nie ma publicznej listy ani głosowania, więc nikt nie podejrzy, co zaproponowali inni.",
  "@help_gMusic_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gSchedule_title": "Harmonogram",
  "help_gSchedule_1Title": "Plan dnia",
  "help_gSchedule_1Body": "Godzina po godzinie: ceremonia, przyjęcie, tort, pierwszy taniec. U góry zobaczysz licznik dni do wesela.",
  "@help_gSchedule_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gGames_title": "Gry",
  "help_gGames_1Title": "Quiz, Prawda/Fałsz, Zgadnij zdjęcie",
  "help_gGames_1Body": "Odpowiedz na wszystkie pytania i wyślij wynik. Możesz podejść ponownie — nowy wynik zastąpi poprzedni, więc nic nie tracisz.",
  "@help_gGames_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gGames_2Title": "Foto-wyzwania",
  "help_gGames_2Body": "Lista zadań fotograficznych. Do każdego wyzwania wysyłasz jedno zdjęcie; kolejne zastąpi poprzednie. Zdjęcia widzą wszyscy goście.",
  "@help_gGames_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gGames_3Title": "Ślubne Bingo",
  "help_gGames_3Body": "Skreślaj pola, gdy zobaczysz je na weselu. Skreślenia zostają na Twoim telefonie — wyślij zgłoszenie dopiero, gdy uzbierasz komplet.",
  "@help_gGames_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gGames_4Title": "Kto widzi wyniki",
  "help_gGames_4Body": "Wyłącznie Para Młoda. Nie ma publicznego rankingu, więc graj dla zabawy, a nie dla rywalizacji.",
  "@help_gGames_4Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gKeepsakes_title": "Pamiątki",
  "help_gKeepsakes_1Title": "Księga gości i rady",
  "help_gKeepsakes_1Body": "Zostaw życzenia albo dobrą radę dla Pary Młodej. Wpisów możesz dodać kilka, a widzą je też inni goście — to trochę wspólna kronika.",
  "@help_gKeepsakes_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gKeepsakes_2Title": "Kapsuła czasu",
  "help_gKeepsakes_2Body": "Prywatna wiadomość do Pary Młodej. Nie zobaczy jej żaden inny gość.",
  "@help_gKeepsakes_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gKeepsakes_3Title": "Mapa gości",
  "help_gKeepsakes_3Body": "Zaznacz, skąd przyjeżdżasz. Jedna pinezka na gościa — możesz ją poprawić, wracając do sekcji.",
  "@help_gKeepsakes_3Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gPrivacy_title": "Prywatność",
  "help_gPrivacy_1Title": "Co widzi Para Młoda",
  "help_gPrivacy_1Body": "Twoje potwierdzenie obecności, wpisy, zdjęcia, propozycje muzyczne i wyniki gier — zawsze z imieniem, które podasz.",
  "@help_gPrivacy_1Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
  "help_gPrivacy_2Title": "Czego nie widzą inni goście",
  "help_gPrivacy_2Body": "Twojego potwierdzenia obecności, wiadomości do kapsuły czasu, propozycji muzycznych ani wyników gier. Publiczne są tylko: księga gości, rady, mapa, galeria i zdjęcia z foto-wyzwań.",
  "@help_gPrivacy_2Body": {
    "description": "Pomoc — treść hasła. Tekst ciągły, bez podstawień; można swobodnie dostosować długość zdań do języka."
  },
